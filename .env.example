# Copy this file to .env and fill in your own values. Never commit .env.

# --- Model ---
# Primary model: every call goes here first
MODEL_PROVIDER=groq
MODEL_NAME=openai/gpt-oss-120b
# Automatic fallback: used only if the primary still fails after one retry. Empty = no fallback
FALLBACK_PROVIDER=gemini
# Check Google AI Studio for the current free-tier Flash model id
FALLBACK_MODEL_NAME=gemini-2.5-flash
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Runner ---
# Comma-separated hosts the runner may open. Empty = only the host of the scanned URL.
ALLOWED_HOSTS=www.saucedemo.com,the-internet.herokuapp.com
# Seconds before an inspection job is killed
RUNNER_TIMEOUT=60
# false = visible browser (required by the brief)
HEADLESS=false
# Seconds to keep the runner's browser open after a scan (useful for demos). 0 = close at once
BROWSER_HOLD_SECONDS=3

# --- Storage ---
DATA_DIR=data
DB_PATH=data/app.db
